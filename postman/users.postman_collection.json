{
  "info": {
    "name": "ЛР5 Users API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ],
  "item": [
    {
      "name": "GET /users/1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/users/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "1"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('JSON and structure', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(body).to.be.an('object'); pm.expect(body.id).to.be.a('number'); ['name','username','email'].forEach(k => pm.expect(body[k]).to.be.a('string')); });",
              "pm.test('Field values', () => {pm.expect(body.username).to.eql(\"Bret\");pm.expect(body.email).to.eql(\"Sincere@april.biz\");pm.expect(body.id).to.eql(1);});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /users",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Test Student\", \"username\": \"student\", \"email\": \"student@example.com\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('JSON and structure', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(body).to.be.an('object'); pm.expect(body.id).to.be.a('number'); ['name','username','email'].forEach(k => pm.expect(body[k]).to.be.a('string')); });",
              "pm.test('Field values', () => {pm.expect(body.name).to.eql(\"Test Student\");pm.expect(body.username).to.eql(\"student\");pm.expect(body.email).to.eql(\"student@example.com\");pm.expect(body.id).to.eql(11);});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /users/1",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Updated Student\", \"username\": \"student\", \"email\": \"updated@example.com\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('JSON and structure', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(body).to.be.an('object'); pm.expect(body.id).to.be.a('number'); ['name','username','email'].forEach(k => pm.expect(body[k]).to.be.a('string')); });",
              "pm.test('Field values', () => {pm.expect(body.name).to.eql(\"Updated Student\");pm.expect(body.username).to.eql(\"student\");pm.expect(body.email).to.eql(\"updated@example.com\");pm.expect(body.id).to.eql(1);});"
            ]
          }
        }
      ]
    }
  ]
}
